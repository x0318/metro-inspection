<?xml version="1.0"?>
<sdf version="1.7">
  <world name="subway_tunnel_v2_preview">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.04 0.045 0.055 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>15.6 0 1.875 0 0.18 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.82 0.82 0.78 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light name="fill" type="point">
      <pose>15.6 0 3.5 0 0 0</pose>
      <diffuse>0.35 0.36 0.38 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>24</range>
        <constant>0.7</constant>
        <linear>0.03</linear>
        <quadratic>0.004</quadratic>
      </attenuation>
    </light>

    <include>
      <uri>model://subway_tunnel_v2</uri>
      <name>subway_tunnel_v2</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://subway_v2_collision_preview</uri>
      <name>subway_v2</name>
      <!-- Treads settle onto rail-top z=0.574; flanges guide inside each rail. -->
      <pose>19.2 0 0.5214 0 0 0</pose>
      <static>false</static>
    </include>
  </world>
</sdf>
