<?xml version="1.0"?>
<sdf version="1.7">
  <model name="subway_tunnel_v2">
    <static>true</static>
    <link name="tunnel">
      <!-- tunnel_8.10 stays at native scale; collisions match its rail geometry. -->
      <collision name="center_drive_surface">
        <pose>15.6 0 0.33 0 0 0</pose>
        <geometry>
          <box>
            <size>31.2 1.45 0.02</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name="left_rail_collision">
        <pose>15.6 0.754 0.486 0 0 0</pose>
        <geometry>
          <box>
            <size>31.2 0.05 0.176</size>
          </box>
        </geometry>
      </collision>
      <collision name="right_rail_collision">
        <pose>15.6 -0.754 0.486 0 0 0</pose>
        <geometry>
          <box>
            <size>31.2 0.05 0.176</size>
          </box>
        </geometry>
      </collision>
      <visual name="tunnel_visual">
        <geometry>
          <mesh>
            <uri>model://subway_tunnel_v2/meshes/subway_tunnel_v2.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <cast_shadows>true</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
