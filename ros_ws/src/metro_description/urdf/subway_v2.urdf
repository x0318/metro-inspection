      rpy="-1.5707963267949 -1.5707963267949 0" />
    <parent link="pitch_camera" />
    <child link="pitch_camera_sensor_link" />
  </joint>

  <link name="pitch_camera_optical_frame" />

  <joint name="pitch_camera_optical_joint" type="fixed">
    <origin
      xyz="0 0 0"
      rpy="-1.5707963267949 0 -1.5707963267949" />
    <parent link="pitch_camera_sensor_link" />
    <child link="pitch_camera_optical_frame" />
  </joint>
