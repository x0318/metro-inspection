    <plugin name="subway_v2_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_drive</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>w2_joint</left_joint>
      <right_joint>w1_joint</right_joint>
      <left_joint>w3_joint</left_joint>
      <right_joint>w4_joint</right_joint>
      <wheel_separation>0.5016</wheel_separation>
      <wheel_separation>0.5016</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>
      <wheel_diameter>0.12</wheel_diameter>
      <max_wheel_torque>40</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="subway_v2_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>w1_joint</joint_name>
      <joint_name>w2_joint</joint_name>
      <joint_name>w3_joint</joint_name>
      <joint_name>w4_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="w1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="w2">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="w3">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="w4">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="odin1_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="odin1_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <ros>
          <namespace>/odin1</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="odin1_lidar" type="gpu_ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>240</samples>
            <resolution>1</resolution>
            <min_angle>-1.0471975511966</min_angle>
            <max_angle>1.0471975511966</max_angle>
          </horizontal>
          <vertical>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-0.78539816339745</min_angle>
            <max_angle>0.78539816339745</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </ray>
      <plugin name="odin1_pointcloud_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/odin1</namespace>
          <remapping>~/out:=cloud_raw</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
    <sensor name="odin1_rgb_camera" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <pose>
      0.01462035 0.03437643 0.00044495
      -0.00208004 -0.00610004 -0.01139042
    </pose>
      <camera name="odin1_rgb">
        <!-- Calibrated 1600x1296 mode for Odin1 O1-P070100024. The published
             129-degree product FOV is not compatible with this camera matrix. -->
        <horizontal_fov>1.6527705344413242</horizontal_fov>
        <image>
          <width>1600</width>
          <height>1296</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
        <!-- No distortion coefficients were supplied, so the simulated image
             remains ideal/undistorted until the complete calibration is available. -->
        <lens>
          <intrinsics>
            <fx>736.9688</fx>
            <fy>737.0365</fy>
            <cx>766.6570</cx>
            <cy>642.9091</cy>
            <s>0.2058</s>
          </intrinsics>
        </lens>
      </camera>
      <plugin name="odin1_rgb_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/odin1</namespace>
          <!-- Gazebo Classic cannot represent fy != fx or nonzero skew in K.
               Preserve its diagnostic output separately; the fusion launch
               republishes the calibrated CameraInfo on the standard topic. -->
          <remapping>rgb/camera_info:=rgb/camera_info_gazebo</remapping>
        </ros>
        <camera_name>rgb</camera_name>
        <frame_name>odin1_rgb_optical_frame</frame_name>
        <!-- Gazebo Classic serializes HFOV with limited precision before the
             plugin sees it. Let the diagnostic topic derive its focal length
             from that HFOV; the calibrated topic below is authoritative. -->
        <cx>766.6570</cx>
        <cy>642.9091</cy>
        <border_crop>false</border_crop>
        <rectification_matrix>1 0 0 0 1 0 0 0 1</rectification_matrix>
        <P_fx>736.9688</P_fx>
        <P_fy>737.0365</P_fy>
        <P_cx>766.6570</P_cx>
        <P_cy>642.9091</P_cy>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="xj1_camera_link">
    <sensor name="xj1_camera_sensor" type="camera">
      <always_on>true</always_on>
