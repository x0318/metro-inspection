  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="odin1_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="odin1_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <ros>
  <namespace>/odin1</namespace>
  <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>
 <gazebo reference="lidar_link">
  <sensor name="odin1_lidar" type="gpu_ray">
    <always_on>true</always_on>
    <visualize>false</visualize>
    <pose>0 0 0 0 0 0</pose>
    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>240</samples>
          <resolution>1</resolution>
          <min_angle>-1.0471975511966</min_angle>
          <max_angle>1.0471975511966</max_angle>
        </horizontal>

        <vertical>
          <samples>180</samples>
          <resolution>1</resolution>
          <min_angle>-0.78539816339745</min_angle>
          <max_angle>0.78539816339745</max_angle>
        </vertical>
      </scan>

      <range>
        <min>0.2</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>

      <noise>
        <type>gaussian</type>
        <mean>0</mean>
        <stddev>0.03</stddev>
      </noise>
    </ray>

    <plugin
      name="odin1_pointcloud_plugin"
      filename="libgazebo_ros_ray_sensor.so">
      <ros>
  <namespace>/odin1</namespace>
  <remapping>~/out:=cloud_raw</remapping>
</ros>
      <output_type>sensor_msgs/PointCloud2</output_type>
      <frame_name>lidar_link</frame_name>
    </plugin>
  </sensor>
    <sensor name="odin1_rgb_camera" type="camera">
    <always_on>true</always_on>
    <visualize>false</visualize>
    <update_rate>10</update_rate>

    <!-- Gazebo camera body frame: +X is the viewing direction. -->
    <pose>
      0.01462035 0.03437643 0.00044495
      -0.00208004 -0.00610004 -0.01139042
    </pose>

    <camera name="odin1_rgb">
      <horizontal_fov>2.25147473507268</horizontal_fov>
      <image>
        <width>1600</width>
        <height>1296</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <!-- Clip the scaled CAD housing without moving the calibrated optical center. -->
        <near>0.10</near>
        <far>100.0</far>
      </clip>
    </camera>

    <plugin
      name="odin1_rgb_camera_plugin"
      filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>/odin1</namespace>
      </ros>
      <camera_name>rgb</camera_name>
      <frame_name>odin1_rgb_optical_frame</frame_name>
    </plugin>
  </sensor>
</gazebo>

  <gazebo reference="xj1">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="xj1_camera_link">
    <sensor name="xj1_camera_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <!-- Hardware maximum: 249.1 FPS; match the current real-camera driver setting. -->
      <update_rate>30</update_rate>

      <!-- The camera link already uses Gazebo's +X-forward body convention. -->
      <pose>0 0 0 0 0 0</pose>

      <camera name="xj1_camera">
        <horizontal_fov>0.7845372999428053</horizontal_fov>

        <image>
          <width>1440</width>
          <height>1080</height>
          <format>B8G8R8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>

        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>

        <distortion>
          <k1>-0.099402</k1>
          <k2>0.115175</k2>
          <k3>0.0</k3>
          <p1>-0.003985</p1>
          <p2>-0.001845</p2>
          <center>0.4835390972222 0.5071845925926</center>
        </distortion>

        <lens>
          <intrinsics>
            <fx>1740.35217</fx>
            <fy>1740.4613</fy>
            <cx>696.2963</cx>
            <cy>547.75936</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>

      <plugin name="xj1_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/subway_v2</namespace>
        </ros>
        <camera_name>xj1</camera_name>
        <frame_name>xj1_optical_frame</frame_name>

        <focal_length>1740.35217</focal_length>
        <cx>696.2963</cx>
        <cy>547.75936</cy>
        <border_crop>false</border_crop>

        <rectification_matrix>1 0 0 0 1 0 0 0 1</rectification_matrix>
        <P_fx>1715.05176</P_fx>
        <P_fy>1723.86292</P_fy>
        <P_cx>693.56983</P_cx>
        <P_cy>545.3029</P_cy>
      </plugin>
    </sensor>
  </gazebo>
