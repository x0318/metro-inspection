  <gazebo>
    <static>false</static>
    <plugin name="subway_v2_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_drive</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
    <plugin name="subway_v2_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>w1_joint</joint_name>
      <joint_name>w2_joint</joint_name>
      <joint_name>w3_joint</joint_name>
      <joint_name>w4_joint</joint_name>
      <joint_name>ph</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <!-- Low slip resistance lets planar_move reproduce omnidirectional motion. -->
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="w1">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="w2">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="w3">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
