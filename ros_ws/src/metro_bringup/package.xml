<?xml version="1.0"?>
<package format="3">
  <name>metro_bringup</name>
  <version>0.1.0</version>
  <description>Unified launch entry point for the metro inspection simulation platform.</description>
  <maintainer email="jo0625@users.noreply.github.com">jo0625</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>metro_closed_loop</exec_depend>
  <exec_depend>metro_dashboard_bridge</exec_depend>
  <exec_depend>metro_description</exec_depend>
  <exec_depend>metro_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
