<?xml version="1.0"?>
<robot name="hardware_inspection_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Hardware inspection car wrapper.
    Visual meshes come from /home/yang/metro-inspection/hardware.
    The physics, sensors and ROS topics stay compatible with the existing pipeline:
      /cmd_vel, /odom, /camera/image_raw, /camera/camera_info, /lidar/points
  -->
  <xacro:property name="base_length" value="0.62"/>
  <xacro:property name="base_width" value="0.46"/>
  <xacro:property name="base_height" value="0.14"/>
  <xacro:property name="base_z" value="0.20"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.055"/>
  <xacro:property name="wheel_y" value="0.22"/>
  <xacro:property name="front_wheel_x" value="0.18"/>
  <xacro:property name="rear_wheel_x" value="-0.18"/>
  <xacro:property name="wheel_z" value="-0.12"/>
  <!-- Side-looking validation pose: camera/lidar look 90 deg to the right wall. -->
  <xacro:property name="sensor_yaw" value="-1.5707963268"/>

  <material name="black"><color rgba="0.01 0.01 0.01 1"/></material>
  <material name="sensor_green"><color rgba="0.05 0.8 0.35 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Simple collision body for stable Gazebo physics. Hardware STL is visual-only below. -->
    <collision name="base_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <surface>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        <contact><ode><kp>1e+06</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
    <inertial>
      <mass value="16.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.25" ixy="0" ixz="0" iyy="0.35" iyz="0" izz="0.45"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="name x y">
    <link name="${name}">
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          <contact><ode><kp>1e+06</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0007"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Invisible physical wheels used by diff_drive; visible hardware wheels come from the STL model. -->
  <xacro:drive_wheel name="left_wheel" x="${front_wheel_x}" y="${wheel_y}"/>
  <xacro:drive_wheel name="right_wheel" x="${front_wheel_x}" y="-${wheel_y}"/>
  <xacro:drive_wheel name="rear_left_wheel" x="${rear_wheel_x}" y="${wheel_y}"/>
  <xacro:drive_wheel name="rear_right_wheel" x="${rear_wheel_x}" y="-${wheel_y}"/>

  <link name="hw_base_link">
    <visual name="base_link_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/base_link.STL"/>
      </geometry>
      <material name="hw_base_link_0_material"><color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/></material>
    </visual>
  </link>
  <link name="hw_w1">
    <visual name="w1_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/w1.STL"/>
      </geometry>
      <material name="hw_w1_0_material"><color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/></material>
    </visual>
  </link>
  <link name="hw_w2">
    <visual name="w2_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/w2.STL"/>
      </geometry>
      <material name="hw_w2_0_material"><color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/></material>
    </visual>
  </link>
  <link name="hw_w3">
    <visual name="w3_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/w3.STL"/>
      </geometry>
      <material name="hw_w3_0_material"><color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/></material>
    </visual>
  </link>
  <link name="hw_w4">
    <visual name="w4_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/w4.STL"/>
      </geometry>
      <material name="hw_w4_0_material"><color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/></material>
    </visual>
  </link>
  <link name="hw_yuntai">
    <visual name="yuntai_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/yuntai.STL"/>
      </geometry>
      <material name="hw_yuntai_0_material"><color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/></material>
    </visual>
  </link>
  <link name="hw_pitch">
    <visual name="pitch_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/pitch.STL"/>
      </geometry>
      <material name="hw_pitch_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <link name="hw_leida">
    <visual name="leida_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/leida.STL"/>
      </geometry>
      <material name="hw_leida_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <link name="hw_xj1">
    <visual name="xj1_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/xj1.STL"/>
      </geometry>
      <material name="hw_xj1_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <link name="hw_xj2">
    <visual name="xj2_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/xj2.STL"/>
      </geometry>
      <material name="hw_xj2_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <link name="hw_xj3">
    <visual name="xj3_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/xj3.STL"/>
      </geometry>
      <material name="hw_xj3_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <link name="hw_xj4">
    <visual name="xj4_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/yang/metro-inspection/hardware/meshes/xj4.STL"/>
      </geometry>
      <material name="hw_xj4_0_material"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>
  <joint name="hardware_body_mount" type="fixed">
    <parent link="base_link"/>
    <child link="hw_base_link"/>
    <!-- Flip only the imported hardware visual mesh by 180 deg; keep base_link, odom, sensors and diff_drive unchanged. -->
    <origin xyz="0 0 -0.04" rpy="1.5707963268 0 3.1415926536"/>
  </joint>
  <joint name="hw_w1" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_w1"/>
    <origin xyz="0.152328939951822 0.103 0.134095970953207" rpy="1.57079632679489 -0.16843576907617 1.5707963267949"/>
  </joint>
  <joint name="hw_w2" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_w2"/>
    <origin xyz="-0.145471060048178 0.103 0.134095970953207" rpy="1.57079632679489 0.16843576907617 -1.5707963267949"/>
  </joint>
  <joint name="hw_w3" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_w3"/>
    <origin xyz="-0.145471060048178 0.102999999999999 -0.155904029046793" rpy="1.57079632679489 1.06806361303278 -1.5707963267949"/>
  </joint>
  <joint name="hw_w4" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_w4"/>
    <origin xyz="0.152328939951822 0.102999999999999 -0.155904029046793" rpy="1.57079632679489 -1.06806361303278 1.5707963267949"/>
  </joint>
  <joint name="hw_yaw" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_yuntai"/>
    <origin xyz="-0.0738710600481814 -0.166 -0.0109040290468001" rpy="3.14159265358979 1.5707963267949 0"/>
  </joint>
  <joint name="hw_ph" type="fixed">
    <parent link="hw_yuntai"/>
    <child link="hw_pitch"/>
    <origin xyz="0 0.01 0" rpy="3.14050535389669 -1.5707963267949 0"/>
  </joint>
  <joint name="hw_ld" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_leida"/>
    <origin xyz="0.00342893995182154 -0.0120000000000005 0.139095970953207" rpy="0 0 0"/>
  </joint>
  <joint name="hw_xj1" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_xj1"/>
    <origin xyz="0.163428939951822 -0.0135000000000005 -0.0109040290467929" rpy="0 -1.5707963267949 0"/>
  </joint>
  <joint name="hw_xj2" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_xj2"/>
    <origin xyz="-0.156571060048178 -0.0135000000000005 -0.0109040290467929" rpy="3.14159265358979 1.5707963267949 0"/>
  </joint>
  <joint name="hw_xj3" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_xj3"/>
    <origin xyz="0.227928939951822 -0.107 -0.229404029046793" rpy="1.5707963267949 -1.5707963267949 0"/>
  </joint>
  <joint name="hw_xj4" type="fixed">
    <parent link="hw_base_link"/>
    <child link="hw_xj4"/>
    <origin xyz="-0.221071060048178 -0.107 -0.229404029046793" rpy="1.5707963267949 1.5707963267949 0"/>
  </joint>

  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.50"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.50"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0.12 0 0.34" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.06 0.06"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.06 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.36 0 0.52" rpy="0 0 ${sensor_yaw}"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="lidar_link">
    <visual name="lidar_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.055"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="lidar_link"/>
    <origin xyz="0.16 0 0.14" rpy="0 0 ${sensor_yaw}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal><samples>720</samples><resolution>1.0</resolution><min_angle>-1.0</min_angle><max_angle>1.0</max_angle></horizontal>
          <vertical><samples>32</samples><resolution>1.0</resolution><min_angle>-0.55</min_angle><max_angle>0.55</max_angle></vertical>
        </scan>
        <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
      </ray>
      <plugin name="lidar_point_cloud" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/lidar</namespace><remapping>~/out:=points</remapping></ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.745</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>front_camera/image_raw:=image_raw</remapping>
          <remapping>front_camera/camera_info:=camera_info</remapping>
        </ros>
        <camera_name>front_camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/cmd_vel</remapping><remapping>odom:=/odom</remapping></ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odometry_source>1</odometry_source>
    </plugin>
  </gazebo>
</robot>
