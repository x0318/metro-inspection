<?xml version="1.0"?>
<robot name="metro_train_inspection_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Metro-sim train-style inspection car.
    The geometry follows /home/yang/metro-inspection/ros_ws/src/metro_sim/models/gazebo_train,
    but keeps the already validated ROS interfaces used by the localization pipeline:
      /cmd_vel, /odom, /camera/image_raw, /camera/camera_info, /lidar/points
  -->
  <xacro:property name="base_length" value="1.20"/>
  <xacro:property name="base_width" value="1.35"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_z" value="0.30"/>
  <xacro:property name="wheel_radius" value="0.105"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="wheel_y" value="0.7525"/>
  <xacro:property name="front_wheel_x" value="0.35"/>
  <xacro:property name="rear_wheel_x" value="-0.35"/>
  <xacro:property name="wheel_z" value="-0.195"/>
  <xacro:property name="sensor_yaw" value="-0.82"/>

  <material name="body_blue">
    <color rgba="0.08 0.38 0.62 1"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>
  <material name="black">
    <color rgba="0.01 0.01 0.01 1"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.05 0.8 0.35 1"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="train_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="front_axle_visual">
      <origin xyz="${front_wheel_x} 0 -0.04" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="1.505"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="rear_axle_visual">
      <origin xyz="${rear_wheel_x} 0 -0.04" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="1.505"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="front_sensor_bar">
      <origin xyz="0.62 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 1.05 0.08"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <surface>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        <contact><ode><kp>1e+06</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.90" ixy="0" ixz="0" iyy="0.45" iyz="0" izz="1.10"/>
    </inertial>
  </link>

  <xacro:macro name="train_wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          <contact><ode><kp>1e+06</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0007"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:train_wheel name="left_wheel" x="${front_wheel_x}" y="${wheel_y}"/>
  <xacro:train_wheel name="right_wheel" x="${front_wheel_x}" y="-${wheel_y}"/>
  <xacro:train_wheel name="rear_left_wheel" x="${rear_wheel_x}" y="${wheel_y}"/>
  <xacro:train_wheel name="rear_right_wheel" x="${rear_wheel_x}" y="-${wheel_y}"/>

  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.72"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.72"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.10 0.10"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.10 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.62 0 0.48" rpy="0 0 ${sensor_yaw}"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="lidar_link">
    <visual name="lidar_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="lidar_ring">
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.21" length="0.025"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="lidar_link"/>
    <origin xyz="0.62 0 0.32" rpy="0 0 ${sensor_yaw}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1.0</resolution>
            <min_angle>-1.0</min_angle>
            <max_angle>1.0</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.55</min_angle>
            <max_angle>0.55</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </ray>
      <plugin name="lidar_point_cloud" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/lidar</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.745</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>front_camera/image_raw:=image_raw</remapping>
          <remapping>front_camera/camera_info:=camera_info</remapping>
        </ros>
        <camera_name>front_camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.505</wheel_separation>
      <wheel_diameter>0.21</wheel_diameter>
      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odometry_source>1</odometry_source>
    </plugin>
  </gazebo>
</robot>
