Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odom
      Topic:
        Value: /odom
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Lidar PointCloud
      Topic:
        Value: /lidar/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Raw Camera
      Topic:
        Value: /camera/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Fusion Debug
      Topic:
        Value: /localization/debug_projection
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Estimated Damage
      Marker Topic:
        Value: /localization/estimated_marker
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Ground Truth
      Marker Topic:
        Value: /localization/truth_marker
  Enabled: true
  Global Options:
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 5
    Focal Point:
      X: 1.5
      Y: 0
      Z: 0.4
    Name: Current View
    Pitch: 0.55
    Yaw: 3.14