<?xml version="1.0"?>
<sdf version="1.6">
  <world name="inspection_tunnel">
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.28 0.28 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_wall_with_damage">
      <static>true</static>
      <pose>3.0 0 0.8 0 0 0</pose>
      <link name="wall">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.08 2.5 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.08 2.5 1.6</size>
            </box>
          </geometry>
          <laser_retro>60.0</laser_retro>
        </collision>
      </link>
    </model>

    <!-- Visual-only texture defect. Lidar measures the concrete wall behind it. -->
    <model name="red_damage_patch">
      <static>true</static>
      <pose>2.94 -0.18 0.65 0 0 0</pose>
      <link name="patch">
        <visual name="patch_visual">
          <geometry>
            <box>
              <size>0.02 0.28 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>